{
  "name": "deck-of-many-more-things",
  "version": "1.0.1",
  "private": true,
  "description": "A bilingual desktop app for drawing from the Deck of Many More Things.",
  "main": "main.cjs",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:desktop": "ng build --base-href=./",
    "watch": "ng build --watch --configuration development",
    "desktop:dev": "concurrently -k \"ng serve --host 127.0.0.1 --port 4300\" \"wait-on http://127.0.0.1:4300 && electron .\"",
    "desktop": "npm run build:desktop && cross-env DESKTOP_USE_BUILT_APP=true electron .",
    "desktop:package": "npm run build:desktop && electron-builder --win nsis",
    "desktop:package:linux": "npm run build:desktop && electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.deckofmanymorethings.app",
    "productName": "Deck of Many More Things",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "dist/deck-of-many-more-things/browser/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "electron@44.7.0": true
  }
}
